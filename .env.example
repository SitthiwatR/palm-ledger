# Server-only configuration. Never prefix these keys with NEXT_PUBLIC_.
# npm run local:setup generates .env.local for a local development stack.
APP_URL=http://127.0.0.1:3000
DATABASE_URL=
# Optional trusted PostgreSQL CA PEM. Vercel deploy:build downloads Supabase's
# official CA over verified HTTPS and bundles it when this override is absent.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
# Optional public contact text shown under "forgot password". No credentials.
SUPPORT_CONTACT=
