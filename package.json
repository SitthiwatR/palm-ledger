{
  "name": "palm-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/prepare-ocr-assets.ts && next dev --hostname 0.0.0.0",
    "build": "tsx scripts/prepare-ocr-assets.ts && next build",
    "deploy:build": "tsx scripts/prepare-database-ca.ts && tsx scripts/migrate.ts && npm run build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts/*.ts tests next.config.ts playwright.config.ts package.json tsconfig.json compose.local.yml",
    "format:check": "prettier --check src scripts/*.ts tests next.config.ts playwright.config.ts package.json tsconfig.json compose.local.yml",
    "test": "node --test model.test.mjs && tsx --test tests/receipt.test.ts tests/expense.test.ts tests/auth-check.test.ts tests/database-network.test.ts tests/owner-cli.test.ts tests/integration.test.ts",
    "test:browser": "tsx scripts/prepare-ocr-assets.ts && playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:test:setup": "tsx scripts/local-setup.ts --test",
    "owner:create": "node --env-file=.env.local --import tsx scripts/owner.ts create",
    "owner:reset": "node --env-file=.env.local --import tsx scripts/owner.ts reset",
    "postinstall": "tsx scripts/prepare-ocr-assets.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "heic-to": "1.6.6",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
