{
  "name": "palm-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts/*.ts tests next.config.ts playwright.config.ts package.json tsconfig.json compose.local.yml",
    "format:check": "prettier --check src scripts/*.ts tests next.config.ts playwright.config.ts package.json tsconfig.json compose.local.yml",
    "test": "node --test model.test.mjs && tsx --test tests/integration.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "local:test:setup": "tsx scripts/local-setup.ts --test",
    "owner:create": "node --env-file=.env.local --import tsx scripts/owner.ts create",
    "owner:reset": "node --env-file=.env.local --import tsx scripts/owner.ts reset"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
